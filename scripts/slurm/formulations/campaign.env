# Parameters of the campaign, read by every script (bash syntax).
CAMPAIGN=formulations-confirmation
JAR=TM-MSAStructAligner-1.0-jar-with-dependencies.jar
SEEDS="1 2 3 4 5 6"
SEED_METHODS=clustalw,kalign,mafft,muscle5,tcoffee,tmaligner
POPULATION=100
# 12 runs at a time with 4 evaluation threads each: 48 of the 50 cores of a task
PARALLEL_RUNS=12
THREADS_PER_RUN=4
JAVA_HEAP=4g
JAVA_MODULE=java/jdk-25
# Analysis (analyse.sh): indicators of formulation_study.py and the configuration to compare with
ANALYSIS_BASELINE=nsgaii
ANALYSIS_INDICATORS="r1_pair_f1 median_pair_f1 r1_tm_pair_f1 r1_tm_gap_rate r1_coverage"
